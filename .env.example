NODE_ENV=production
PORT=3000
BASE_URL=https://seu-dashboard.com

# Use o Client ID e Client Secret da aplicacao Discord, nao o token do bot.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://seu-dashboard.com/api/auth/callback
ALLOWED_DISCORD_USER_IDS=123456789012345678
SESSION_SECRET=troque-por-uma-string-grande-e-aleatoria

# Use chave pessoal do PostHog aqui. A project API key do bot nao consulta HogQL.
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_QUERY_TIMEOUT_MS=30000

# Use false so para abrir o painel localmente sem login.
AUTH_REQUIRED=true
